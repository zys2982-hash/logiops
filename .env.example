APP_ENV=local
API_PREFIX=/api/v1
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据库：路径 A = 本机 MySQL 8（默认，3306）；路径 B = docker compose（3307）
DATABASE_URL=mysql+pymysql://logiops:logiops@127.0.0.1:3306/logiops?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://logiops:logiops@127.0.0.1:3306/logiops_test?charset=utf8mb4
# 无 MySQL 时的临时回落（仅本地冒烟用，FULLTEXT 知识检索不可用）：
# DATABASE_URL=sqlite+pysqlite:///./logiops.db

# 演示与可复现
DEMO_BASE_DATE=2026-09-30T09:00:00+08:00
DEMO_RANDOM_SEED=20260930
# 演示数据规模：compact=每种异常类型一单（3 单，默认，界面清爽）| full=1000 单完整规模
SEED_SCALE=compact
# 演示账号（owner/admin/operator/viewer）的口令，seed 建号时用它哈希入库。
# ⚠️ 本仓库是公开的 → 下面这个默认值等于公开口令。部署到公网请改成强口令（scripts/deploy-env.sh 会自动生成），
#    改完必须重新 seed：docker compose exec backend python -m app.seed --reset --demo
DEMO_PASSWORD=Demo@12345

# --- docker compose 部署（路径 B）用；缺 SECRET_KEY / MYSQL_* 时 compose 会直接报错 ---
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=logiops
WEB_PORT=80
# 云上填你的站点地址（同源部署其实用不到，填上更稳）
# CORS_ORIGINS=http://1.2.3.4
# 时钟：system = **真实时间**（现行默认，系统用 now()）；replay = 演示虚拟时钟
# （固定基准日 + /demo/actions/tick 推进；保留给单元测试与一键验收，保证可复现）
CLOCK_MODE=system
AI_MODE=replay
AI_REPLAY_DIR=tests/fixtures/ai

# LLM（仅 AI_MODE=live 时生效）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE_ANALYSIS=0.2
LLM_TEMPERATURE_NOTICE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_TOKENS=8000
# T2 输出的完整 JSON（摘要+建议+证据）在中文下约 1–3k token；
# 1500 会导致输出被截断（JSON 未闭合）而校验失败，故默认 4000。
LLM_MAX_OUTPUT_TOKENS=4000
LLM_DAILY_COST_LIMIT_CNY=20

# 规则阈值
DETECT_STALL_MINUTES=120
DETECT_DEBOUNCE_MINUTES=30
RISK_VIP_UPGRADE=true
KNOWLEDGE_TOP_K=5
